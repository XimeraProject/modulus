{
  "name": "osu.modulus-learning.org",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "clean": "rm -rf node_modules .output .nitro .tanstack",
    "dev": "vite dev",
    "devlti": "cross-env DEV_HTTPS=true NODE_OPTIONS=--use-openssl-ca vite dev --host modulus.infonomic.local",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "start:frontend": "cross-env DEPLOYMENT_MODE=frontend JOB_QUEUE_ENABLED=false node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "start:admin": "cross-env DEPLOYMENT_MODE=admin node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write --diagnostic-level=error",
    "lint:check": "biome check --diagnostic-level=error",
    "db:up": "./postgres/postgres.sh up -d",
    "db:down": "./postgres/postgres.sh down",
    "test:css": "node --test 'tests/css/*.test.ts'",
    "test:css-build": "CSS_BUILD_CHECK=1 node --test 'tests/css/css-contract.test.ts'"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@google-cloud/recaptcha-enterprise": "^7.3.0",
    "@infonomic/uikit": "^6.9.1",
    "@modulus-learning/core": "0.13.0",
    "@modulus-learning/host-tanstack-start": "0.13.0",
    "@modulus-learning/lms-canvas": "0.13.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "argon2": "^0.45.2",
    "bcrypt": "^6.0.0",
    "googleapis": "^190.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "lucide-react": "^1.77.0",
    "mdast-util-to-string": "^4.0.0",
    "nitro": "3.0.261103-rc",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  }
}
