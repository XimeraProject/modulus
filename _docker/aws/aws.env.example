# AWS settings for the OSU deploy scripts. Copy to _docker/aws/aws.env
# (gitignored) and fill in. The scripts read this file; nothing here is a
# secret, but account IDs and ARNs stay out of the repository.

# The AWS CLI profile for the OSU account (`aws configure list-profiles`).
AWS_PROFILE=osu
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=000000000000

# ECR repository; images are tagged app-<version> (default: git short sha).
ECR_REPOSITORY=osu-modulus

# ECS cluster, services and task definition families.
ECS_CLUSTER=osu-modulus
ECS_SERVICE_APP=osu-modulus-app
ECS_SERVICE_ADMIN=osu-modulus-admin
TASK_FAMILY_APP=osu-modulus-app
TASK_FAMILY_ADMIN=osu-modulus-admin

# IAM roles. The execution role pulls from ECR, writes logs, and reads the
# secret below; the task role is what the running app may call.
EXECUTION_ROLE_ARN=arn:aws:iam::000000000000:role/osu-modulus-ecs-execution
TASK_ROLE_ARN=arn:aws:iam::000000000000:role/osu-modulus-ecs-task

# One Secrets Manager secret holding a JSON object of the secret variables
# listed in _docker/README.md. Use the full ARN, including its random suffix.
SECRET_ARN=arn:aws:secretsmanager:us-east-2:000000000000:secret:osu-modulus/production-AbCdEf

# Public origins. The app (DEPLOYMENT_MODE=frontend) serves learners and LTI;
# the admin instance serves the administrative UI and runs the background jobs.
APP_HOST=osu-app.modulus-learning.org
ADMIN_HOST=osu-admin.modulus-learning.org

# Capacity provider (the Graviton Auto Scaling group) for the one-off
# `db upgrade` task. Leave empty to use the EC2 launch type directly.
ECS_CAPACITY_PROVIDER=osu-modulus-ec2

# ALB target groups; deploy.sh attaches each service to one when it creates
# the service on the first deploy.
TARGET_GROUP_APP_ARN=arn:aws:elasticloadbalancing:us-east-2:000000000000:targetgroup/osu-modulus-app/0000000000000000
TARGET_GROUP_ADMIN_ARN=arn:aws:elasticloadbalancing:us-east-2:000000000000:targetgroup/osu-modulus-admin/0000000000000000

# Task sizing on the container instances (CPU units / MiB, a hard limit) and
# the matching Node heap ceiling (MiB). Leave room for nginx in the memory.
# Both services' tasks must fit on one t4g.medium (2048 CPU units, about
# 3.7 GiB registered); the extra app task of a rolling deploy makes ECS
# scale out a second instance briefly.
TASK_CPU=1024
TASK_MEMORY=1536
NODE_MAX_OLD_SPACE_SIZE=1024

# Public, non-secret application settings shared by both task definitions.
SITE_NAME=MODULUS
SITE_DESCRIPTION='Modulus - an open source educational analytics system for distributed learning content.'
SYSTEM_EMAIL_FROM_ADDRESS='Modulus Learning <noreply@osu.modulus-learning.org>'
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true
S3_BUCKET=osu-modulus-assets
S3_CDN_DOMAIN=https://cdn.osu.modulus-learning.org
